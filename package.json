{
  "name": "dsh-archive-cleanup",
  "version": "0.1.0",
  "description": "Permanently delete archived sessions, auto-delete old archives, and restore deleted workspaces in DeepSeek Harness",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "archive",
    "sessions",
    "trash"
  ],
  "license": "MIT",
  "author": "emreasln",
  "homepage": "https://github.com/emreasln/dsh-archive-cleanup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emreasln/dsh-archive-cleanup.git"
  },
  "bugs": {
    "url": "https://github.com/emreasln/dsh-archive-cleanup/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.3 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.3 <0.3.0"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/types.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
